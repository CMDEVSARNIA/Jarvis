# ---- Claude (required) ------------------------------------------------------
# Get a key at https://platform.claude.com  (API usage is billed separately from a claude.ai subscription)
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5-5
# low = fastest replies (best for voice). medium/high = more careful thinking, slower.
JARVIS_EFFORT=low
# What Jarvis calls you
OWNER_NAME=sir
# Your city for weather and time (e.g. "Toronto, Canada"), and metric or imperial
HOME_LOCATION=
UNITS=metric
# Daily briefing (spoken + sent to Telegram), 24h HH:MM. Blank = only when the HUD opens.
BRIEFING_TIME=08:00
# Evening recap (tomorrow + open items), 24h HH:MM. Blank = off.
RECAP_TIME=21:00
# Proactive nudges (event heads-ups, rain warnings) between 07:00 and 22:00
NUDGES=true
# Your calendar's private iCal link (Google: Settings > calendar > "Secret address in
# iCal format"; Outlook: Settings > Calendar > Shared calendars > Publish > ICS). A secret.
CALENDAR_ICS_URL=
# Only on a cloud server: your time zone, e.g. America/Toronto (a PC uses its own clock)
JARVIS_TIMEZONE=
# Only for a personal or service-account key that ISN'T scoped to one workspace:
# the workspace to use (platform.claude.com > Workspaces, starts with wrkspc_).
ANTHROPIC_WORKSPACE_ID=

# ---- Local HUD ---------------------------------------------------------------
# How the HUD opens: app = Microsoft Edge app window (default), edge = Edge tab,
# tab = your default browser. HUD_FULLSCREEN=true starts it fullscreen (F11 toggles).
HUD_WINDOW=app
HUD_FULLSCREEN=false
# Keep 127.0.0.1 so the HUD is only reachable from this PC.
HOST=127.0.0.1
PORT=8000

# ---- Phone chat via Telegram (free, no public URL needed) -------------------
# 1. Message @BotFather on Telegram -> /newbot -> paste the token here.
# 2. Start Jarvis, message your bot once; it replies with your chat id. Paste it below and restart.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ---- Phone calls via Twilio (optional, paid) --------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number, E.164 format, e.g. +15551234567
TWILIO_FROM_NUMBER=
# YOUR cell number. Jarvis only ever calls / accepts calls from this number.
OWNER_PHONE_NUMBER=
# Your free static ngrok domain (ngrok dashboard > Domains), e.g. your-name.ngrok-free.app
# On a PC, Jarvis starts the tunnel itself (needs ngrok installed or ngrok.exe in this folder).
NGROK_DOMAIN=
# Only if you use some other tunnel: its public HTTPS URL, no trailing slash.
PUBLIC_BASE_URL=
# Twilio text-to-speech voice used on calls
TWILIO_VOICE=Polly.Brian
# Let you ring Jarvis from your cell. Off by default: caller ID can be faked,
# so anyone spoofing your number would get Jarvis. Outbound calls are unaffected.
ALLOW_INBOUND_CALLS=false

# ---- Updates -------------------------------------------------------------------
# start-jarvis.bat updates Jarvis from GitHub on each start. false = never.
AUTO_UPDATE=true
